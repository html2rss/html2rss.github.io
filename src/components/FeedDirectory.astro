---
import { Icon } from "@astrojs/starlight/components";
---

<section class="feed-directory not-content" data-feed-directory aria-label="Feed directory">
  <p class="catalog-status" data-catalog-status hidden aria-live="polite"></p>

  <div class="directory-controls">
    <div class="search-block">
      <label class="sr-only" for="search-input">Search feeds</label>
      <div class="search-field">
        <span class="search-icon" aria-hidden="true">
          <Icon name="magnifying-glass" />
        </span>
        <input
          type="search"
          name="search"
          id="search-input"
          class="search-input"
          placeholder="Search feeds, sites, or domains"
          aria-label="Search feeds"
          enterkeyhint="search"
        />
      </div>
      <p class="result-summary">
        <span>Search across </span>
        <span data-result-count>0</span>
        <span data-result-label>ready-to-use feeds</span>
      </p>
    </div>

    <div class="filter-block">
      <div class="filter-group">
        <p class="filter-label" id="topic-filter-label">Topics</p>
        <div class="topic-chips" data-topic-chips role="group" aria-labelledby="topic-filter-label"></div>
      </div>

      <div class="filter-actions">
        <div class="language-filter">
          <label class="filter-label" for="language-filter">Language</label>
          <select
            id="language-filter"
            class="language-select"
            data-language-filter
            aria-label="Filter by language"
          >
            <option value="">All languages</option>
          </select>
        </div>

        <button type="button" class="export-opml" data-export-opml>Export OPML</button>
      </div>
    </div>

    <div class="instance-block">
      <div class="instance-line">
        <span class="instance-label">Using instance:</span>
        <span class="instance-value" data-instance-host>1.h2r.workers.dev</span>
        <button
          type="button"
          class="instance-toggle"
          data-toggle-instance
          aria-expanded="false"
          aria-controls="instance-editor"
        >
          Change
        </button>
      </div>

      <div class="instance-editor" id="instance-editor" hidden>
        <div class="instance-editor-row">
          <label class="sr-only" for="instance-url-input">Instance URL</label>
          <input
            type="text"
            name="instance"
            id="instance-url-input"
            class="instance-input"
            aria-label="Instance URL"
            placeholder="https://your-instance.com"
            inputmode="url"
            spellcheck="false"
          />
          <button type="button" class="instance-apply" data-apply-instance>Apply</button>
        </div>
        <p class="instance-feedback" data-instance-feedback aria-live="polite">
          Feed links update when you apply a valid instance URL.
        </p>
      </div>
    </div>
  </div>

  <div class="empty-state" data-empty-state hidden>
    <p class="empty-title">No configurations found.</p>
    <p class="empty-copy" data-empty-copy>
      Try another domain or feed name, check the community wiki, or contribute a new configuration.
    </p>
    <div class="empty-actions">
      <a
        href="https://github.com/html2rss/html2rss-web/wiki/Instances"
        target="_blank"
        rel="noopener noreferrer nofollow"
      >
        Community wiki
      </a>
      <a
        href="https://github.com/html2rss/html2rss-configs/tree/master/lib/html2rss/configs"
        target="_blank"
        rel="noopener noreferrer nofollow"
      >
        Contribute on GitHub
      </a>
    </div>
  </div>

  <div class="feed-table" data-feed-list id="catalog-root" aria-live="polite"></div>
</section>

<script type="module" src="./feed-directory.js"></script>

<style>
  [hidden] {
    display: none !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .feed-directory {
    --fd-surface: var(--sl-color-black);
    --fd-surface-alt: var(--sl-color-bg);
    --fd-border: var(--sl-color-gray-5);
    --fd-muted: var(--sl-color-gray-3);
    --fd-padding: 0.875rem;
    --fd-gap: 0.5rem;
    --fd-radius: 0.5rem;
    display: grid;
    gap: var(--fd-gap);
    color: var(--sl-color-white);
  }

  .catalog-status {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--fd-border);
    border-radius: var(--fd-radius);
    background: var(--fd-surface);
    color: var(--fd-muted);
    font-size: var(--sl-text-sm);
  }

  .catalog-status[data-state="error"] {
    color: var(--sl-color-red-high);
  }

  .directory-controls,
  .empty-state,
  .feed-table {
    border: 1px solid var(--fd-border);
    border-radius: var(--fd-radius);
    background: var(--fd-surface);
  }

  .directory-controls {
    display: grid;
    overflow: hidden;
  }

  .search-block,
  .filter-block,
  .instance-block,
  .empty-state,
  .feed-row,
  .parameter-form {
    padding: var(--fd-padding);
  }

  .search-block,
  .filter-block {
    display: grid;
    gap: var(--fd-gap);
    border-bottom: 1px solid var(--fd-border);
  }

  .search-field {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid var(--fd-border);
    border-radius: calc(var(--fd-radius) - 0.125rem);
    background: var(--fd-surface-alt);
  }

  .search-field:focus-within {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 1px var(--sl-color-accent);
  }

  .search-icon {
    position: absolute;
    inset-inline-start: var(--fd-padding);
    display: inline-flex;
    color: var(--fd-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    min-width: 0;
    padding: 0.625rem 0.875rem 0.625rem 2.5rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
  }

  .search-input::placeholder {
    color: var(--fd-muted);
  }

  .search-input:focus {
    outline: none;
  }

  .filter-group {
    display: grid;
    gap: 0.375rem;
  }

  .filter-label {
    margin: 0;
    color: var(--fd-muted);
    font-size: var(--sl-text-xs);
  }

  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .topic-chip {
    appearance: none;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--fd-border);
    border-radius: calc(var(--fd-radius) - 0.125rem);
    background: transparent;
    color: var(--fd-muted);
    font: inherit;
    font-size: var(--sl-text-xs);
    cursor: pointer;
  }

  .topic-chip[aria-pressed="true"] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }

  .filter-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--fd-gap);
    align-items: end;
    justify-content: space-between;
  }

  .language-filter {
    display: grid;
    gap: 0.375rem;
    min-width: 10rem;
  }

  .language-select {
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--fd-border);
    border-radius: calc(var(--fd-radius) - 0.125rem);
    background: var(--fd-surface-alt);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
  }

  .export-opml {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--fd-border);
    border-radius: calc(var(--fd-radius) - 0.125rem);
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }

  .result-summary,
  .instance-feedback,
  .empty-title,
  .empty-copy,
  .feed-summary,
  .feed-title {
    margin: 0;
  }

  .result-summary,
  .instance-line,
  .feed-summary,
  .empty-copy {
    color: var(--fd-muted);
  }

  .result-summary,
  .feed-summary {
    font-size: var(--sl-text-sm);
  }

  .instance-block {
    display: grid;
    gap: var(--fd-gap);
  }

  .instance-line {
    display: flex;
    align-items: center;
    gap: var(--fd-gap);
    min-width: 0;
    font-size: var(--sl-text-sm);
  }

  .instance-label {
    white-space: nowrap;
  }

  .instance-value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--sl-color-white);
    font-family: var(--sl-font-system-mono);
    font-size: var(--sl-text-xs);
  }

  .instance-editor {
    display: grid;
    gap: var(--fd-gap);
  }

  .instance-editor-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--fd-gap);
  }

  .instance-input,
  .form-input {
    min-width: 0;
    border: 1px solid var(--fd-border);
    border-radius: calc(var(--fd-radius) - 0.125rem);
    background: var(--fd-surface-alt);
    color: var(--sl-color-white);
    font: inherit;
  }

  .instance-input {
    padding: 0.625rem 0.75rem;
  }

  .instance-feedback {
    font-size: var(--sl-text-xs);
  }

  .instance-feedback[data-state="error"] {
    color: var(--sl-color-red-high);
  }

  .instance-feedback[data-state="success"] {
    color: var(--sl-color-green-high);
  }

  .feed-table {
    overflow: hidden;
  }

  .feed-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--fd-gap);
    border-top: 1px solid var(--fd-border);
  }

  .feed-row:first-of-type {
    border-top: 0;
  }

  .feed-row:hover,
  .feed-row:focus-within {
    background: var(--sl-color-gray-7);
  }

  .feed-info {
    min-width: 0;
    display: grid;
    gap: var(--fd-gap);
  }

  .feed-mainline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
  }

  .feed-subline {
    display: grid;
    gap: 0.5rem;
  }

  .feed-title {
    font-size: var(--sl-text-base);
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .feed-advanced summary {
    cursor: pointer;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
  }

  .feed-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--sl-text-xs);
    margin-top: 0.5rem;
  }

  .meta-tag {
    color: var(--fd-muted);
  }

  .meta-link {
    appearance: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    font: inherit;
    cursor: pointer;
  }

  .meta-link:hover,
  .meta-link:focus-visible {
    color: var(--sl-color-white);
    text-decoration: underline;
    outline: none;
  }

  .feed-actions {
    justify-self: end;
    align-self: start;
  }

  .action,
  .instance-toggle,
  .instance-apply,
  .done-button {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--fd-border);
    border-radius: calc(var(--fd-radius) - 0.125rem);
    background: transparent;
    color: var(--sl-color-white);
    text-decoration: none;
    font: inherit;
    cursor: pointer;
  }

  .action-primary {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .instance-toggle {
    color: var(--sl-color-gray-3);
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .feed-directory:not([data-enhanced="true"]) .instance-toggle {
    display: none;
  }

  .meta-link[data-copied="true"] {
    color: var(--sl-color-green-high);
  }

  .action:hover,
  .action:focus-visible,
  .meta-link:focus-visible,
  .instance-toggle:hover,
  .instance-toggle:focus-visible,
  .instance-apply:hover,
  .instance-apply:focus-visible,
  .done-button:hover,
  .done-button:focus-visible,
  .topic-chip:hover,
  .topic-chip:focus-visible,
  .export-opml:hover,
  .export-opml:focus-visible,
  .language-select:focus-visible,
  .instance-input:focus-visible,
  .form-input:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
    outline: none;
    box-shadow: 0 0 0 1px var(--sl-color-accent);
  }

  .empty-state {
    display: grid;
    gap: var(--fd-gap);
  }

  .empty-title {
    font-size: var(--sl-text-base);
    font-weight: 600;
  }

  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--fd-gap);
  }

  .empty-actions a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }

  .empty-actions a:hover {
    text-decoration: underline;
  }

  .parameter-form {
    display: grid;
    gap: var(--fd-gap);
    padding-top: 0;
    border-top: 1px solid var(--fd-border);
  }

  .form {
    display: grid;
    gap: var(--fd-gap);
  }

  .form-group {
    display: grid;
    gap: 0.25rem;
  }

  .form-label {
    color: var(--fd-muted);
    font-size: var(--sl-text-xs);
  }

  .form-input {
    padding: 0.625rem 0.75rem;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--fd-gap);
    justify-content: flex-end;
    align-items: center;
  }

  @media (max-width: 49.99rem) {
    .instance-line {
      display: grid;
      grid-template-columns: auto 1fr auto;
    }

    .instance-editor-row {
      grid-template-columns: 1fr;
    }

    .feed-mainline {
      gap: 0.375rem;
    }

    .filter-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
